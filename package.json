{
  "name": "open-career-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --experimental-strip-types scripts/validate-profile.mjs && tsc -b && vite build && node scripts/generate-offline-shell.mjs",
    "test": "vitest run",
